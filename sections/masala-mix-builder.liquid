{%- comment -%}
  Build Your Own Masala Mix — Online Store 2.0 section
  ---------------------------------------------------------------------------
  Customers choose spices (real products and variants from a collection),
  build a blend in a live summary panel and add it to the cart through the
  Ajax Cart API.

  Requires:
    assets/masala-mix-builder.css
    assets/masala-mix-builder.js

  Nothing is hardcoded: products, images, variants, prices and stock come from
  the selected collection. Weights are read from a variant metafield, the
  option value / variant title (e.g. "10 g"), or optionally the shipping weight.

  Storefront copy that isn't a section setting lives in the "strings" block of
  the config JSON near the bottom of this file — translate it there.
{%- endcomment -%}

{{ 'masala-mix-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'masala-mix-builder.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign mmb_collection = s.collection
  assign uid = 'MasalaMix-' | append: section.id

  assign rn_ns = ''
  assign rn_key = ''
  assign rn_parts = s.regional_name_metafield | default: '' | strip | split: '.'
  if rn_parts.size == 2
    assign rn_ns = rn_parts.first | strip
    assign rn_key = rn_parts.last | strip
  endif

  assign vw_ns = ''
  assign vw_key = ''
  assign vw_parts = s.variant_weight_metafield | default: '' | strip | split: '.'
  if vw_parts.size == 2
    assign vw_ns = vw_parts.first | strip
    assign vw_key = vw_parts.last | strip
  endif

  assign cols_tablet = s.columns_desktop | at_most: 3
  assign card_px = s.container_width | times: 0.66 | divided_by: s.columns_desktop | round
  assign img_sizes = '(min-width: 1200px) ' | append: card_px | append: 'px, (min-width: 990px) calc(62vw / ' | append: cols_tablet | append: '), (min-width: 750px) calc(92vw / ' | append: cols_tablet | append: '), calc(92vw / ' | append: s.columns_mobile | append: ')'

  case s.image_ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '4 / 3'
    when 'natural'
      assign ratio = 'auto'
    else
      assign ratio = '1 / 1'
  endcase

  assign fixed_cents = s.fixed_bundle_price | default: '0' | remove: ',' | strip | times: 100 | round
  assign weight_rate_cents = s.weight_price_per_unit | default: '0' | remove: ',' | strip | times: 100 | round

  assign bundle_product = s.bundle_product
  assign bundle_variant = nil
  if bundle_product
    assign bundle_variant = bundle_product.selected_or_first_available_variant
  endif

  if s.cart_mode == 'individual' and s.pricing_strategy == 'sum'
    assign total_label = 'Total'
  else
    assign total_label = 'Bundle price'
  endif

  if s.title != blank
    assign step_tag = 'h3'
    assign card_tag = 'h4'
  else
    assign step_tag = 'h2'
    assign card_tag = 'h3'
  endif

  assign features = section.blocks | where: 'type', 'feature'
-%}

{%- capture icon_search -%}<svg class="mmb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>{%- endcapture -%}
{%- capture icon_close -%}<svg class="mmb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg>{%- endcapture -%}
{%- capture icon_check -%}<svg class="mmb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>{%- endcapture -%}
{%- capture icon_btn_check -%}<svg class="mmb-icon mmb-icon--check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>{%- endcapture -%}
{%- capture icon_btn_plus -%}<svg class="mmb-icon mmb-icon--plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>{%- endcapture -%}
{%- capture icon_minus -%}<svg class="mmb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/></svg>{%- endcapture -%}
{%- capture icon_plus -%}<svg class="mmb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>{%- endcapture -%}
{%- capture icon_trash -%}<svg class="mmb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M10 11v6M14 11v6M9 7V4.5h6V7M6 7l1 12.5h10L18 7"/></svg>{%- endcapture -%}
{%- capture icon_bowl -%}<svg class="mmb-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 22h36a18 18 0 0 1-36 0Z"/><path d="M28 22 38 8"/><path d="M15 16c1-2 3-2 4 0M22 13c1-2 3-2 4 0"/></svg>{%- endcapture -%}

<style>
  #{{ uid }} {
    --mmb-max-width: {{ s.container_width }}px;
    --mmb-pad-top: {{ s.padding_top }}px;
    --mmb-pad-bottom: {{ s.padding_bottom }}px;
    --mmb-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --mmb-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
    --mmb-column-gap: {{ s.column_gap }}px;
    --mmb-card-gap: {{ s.card_gap }}px;
    --mmb-cols-desktop: {{ s.columns_desktop }};
    --mmb-cols-tablet: {{ cols_tablet }};
    --mmb-cols-mobile: {{ s.columns_mobile }};
    --mmb-ratio: {{ ratio }};
    --mmb-fit: {{ s.image_fit }};
    --mmb-radius: {{ s.card_radius }}px;
    --mmb-sticky-top: {{ s.sticky_offset }}px;
    {%- if s.use_custom_colors %}
    --mmb-bg: {{ s.color_background }};
    --mmb-surface: {{ s.color_surface }};
    --mmb-panel: {{ s.color_panel }};
    --mmb-text: {{ s.color_text }};
    --mmb-button: {{ s.color_button }};
    --mmb-button-text: {{ s.color_button_text }};
    --mmb-accent: {{ s.color_accent }};
    {%- endif %}
  }
</style>

<masala-mix-builder
  id="{{ uid }}"
  class="mmb mmb--scheme-{{ s.color_scheme }} mmb--ratio-{{ s.image_ratio }} mmb--summary-{{ s.mobile_summary_position }}{% if s.sticky_summary %} mmb--sticky{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="mmb__container">
    {%- if s.title != blank or s.subtitle != blank -%}
      <header class="mmb__header">
        {%- if s.title != blank -%}
          <h2 class="mmb__title">{{ s.title | escape }}</h2>
        {%- endif -%}
        {%- if s.subtitle != blank -%}
          <p class="mmb__subtitle">{{ s.subtitle | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if request.design_mode -%}
      {%- capture editor_notes -%}
        {%- unless mmb_collection -%}
          <li>Select a <strong>Collection</strong> in the section settings to show your spices.</li>
        {%- endunless -%}
        {%- if s.cart_mode == 'bundle_product' -%}
          {%- unless bundle_variant -%}
            <li>Cart mode is <strong>One bundle product</strong> but no bundle product is selected, so Add to Cart is blocked.</li>
          {%- endunless -%}
        {%- endif -%}
        {%- if s.cart_mode == 'bundle_product' and s.pricing_strategy == 'sum' -%}
          <li>“Sum of individual products” can’t be charged on a single bundle product, so the bundle variant’s price is used. Choose “Fixed” or “Weight-based”, or switch cart mode to individual lines.</li>
        {%- endif -%}
        {%- if s.cart_mode == 'individual' and s.pricing_strategy != 'sum' -%}
          <li>With individual cart lines Shopify charges each spice’s own price. The bundle price shown is only charged if you set up a matching discount (Shopify Function / bundle app, or the discount code setting). Lines are tagged with <code>_bundle_id</code> when “Tag cart lines” is on so a discount can target them.</li>
        {%- endif -%}
        {%- if s.max_bundle_weight > 0 and s.min_bundle_weight > s.max_bundle_weight -%}
          <li>Minimum bundle weight is greater than the maximum, so the minimum is ignored.</li>
        {%- endif -%}
      {%- endcapture -%}
      <div class="mmb-notice" data-mmb-editor-notices{% if editor_notes == blank %} hidden{% endif %}>
        <p><strong>Setup notes</strong> — only visible in the theme editor.</p>
        <ul>{{ editor_notes }}</ul>
      </div>
    {%- endif -%}

    <div class="mmb__layout" data-mmb-layout>
      {%- comment -%} ---------- 1. Product selection ---------- {%- endcomment -%}
      <div class="mmb__products">
        <div class="mmb-step-head">
          {%- if s.show_step_numbers -%}<span class="mmb-step" aria-hidden="true">1</span>{%- endif -%}
          <{{ step_tag }} class="mmb-step-head__title">{{ s.products_heading | escape }}</{{ step_tag }}>
        </div>
        {%- if s.products_description != blank -%}
          <p class="mmb__intro">{{ s.products_description | escape }}</p>
        {%- endif -%}

        {%- if s.show_search -%}
          <div class="mmb-search" role="search">
            <label class="mmb-visually-hidden" for="{{ uid }}-search">{{ s.search_placeholder | default: 'Search spices' | escape }}</label>
            <span class="mmb-search__icon">{{ icon_search }}</span>
            <input
              class="mmb-search__input"
              id="{{ uid }}-search"
              type="search"
              data-mmb-search
              placeholder="{{ s.search_placeholder | escape }}"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="search"
              aria-describedby="{{ uid }}-search-status"
            >
            <button type="button" class="mmb-search__clear" data-mmb-action="clear-search" aria-label="Clear search" hidden>
              {{- icon_close -}}
            </button>
          </div>
          <p class="mmb-search__status" id="{{ uid }}-search-status" data-mmb-search-status hidden></p>
        {%- endif -%}

        {%- if mmb_collection -%}
          {%- paginate mmb_collection.products by s.products_per_page -%}
            {%- assign mmb_current_page = paginate.current_page -%}
            {%- assign mmb_total_pages = paginate.pages -%}
            {%- assign mmb_total_items = paginate.items -%}
            <ul
              class="mmb__grid"
              role="list"
              data-mmb-grid
              data-total-pages="{{ paginate.pages }}"
              aria-label="{{ s.products_heading | escape }}"
            >
              {%- for product in mmb_collection.products -%}
                {%- if product.gift_card? -%}{%- continue -%}{%- endif -%}
                {%- if s.hide_sold_out and product.available == false -%}{%- continue -%}{%- endif -%}
                {%- liquid
                  assign regional_name = ''
                  if rn_ns != blank
                    assign regional_name = product.metafields[rn_ns][rn_key].value | default: ''
                  endif
                  assign card_id = uid | append: '-' | append: product.id
                  assign initial_variant = product.selected_or_first_available_variant
                  assign img_alt = product.featured_image.alt | default: product.title
                -%}
                <li
                  class="mmb-card{% unless product.available %} is-sold-out{% endunless %}"
                  data-mmb-card
                  data-product-id="{{ product.id }}"
                  tabindex="-1"
                  aria-labelledby="{{ card_id }}-title"
                >
                  <div class="mmb-card__media">
                    {%- if product.featured_image -%}
                      {{
                        product.featured_image
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          widths: '160, 240, 320, 400, 600',
                          sizes: img_sizes,
                          alt: img_alt,
                          class: 'mmb-card__img'
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'mmb-card__img mmb-card__img--placeholder' }}
                    {%- endif -%}
                    <span class="mmb-card__check" aria-hidden="true">{{ icon_check }}</span>
                    {%- unless product.available -%}
                      <span class="mmb-card__flag">Sold out</span>
                    {%- endunless -%}
                  </div>

                  <div class="mmb-card__body">
                    <{{ card_tag }} class="mmb-card__title" id="{{ card_id }}-title">{{ product.title | escape }}</{{ card_tag }}>
                    {%- if s.show_regional_name and regional_name != blank -%}
                      <p class="mmb-card__regional">{{ regional_name | escape }}</p>
                    {%- endif -%}
                    {%- if s.show_card_price -%}
                      <p class="mmb-card__price" data-mmb-card-price>{{ initial_variant.price | money }}</p>
                    {%- endif -%}

                    {%- if s.show_weight_selectors and product.has_only_default_variant == false -%}
                      {%- for option in product.options_with_values -%}
                        {%- assign option_index = forloop.index0 -%}
                        <fieldset class="mmb-options" data-mmb-option-group="{{ option_index }}">
                          <legend class="mmb-options__legend{% if product.options.size == 1 %} mmb-visually-hidden{% endif %}">
                            {{- option.name | escape -}}
                          </legend>
                          <div class="mmb-pills">
                            {%- for value in option.values -%}
                              {%- assign value_name = value.name | default: value -%}
                              <label class="mmb-pill">
                                <input
                                  type="radio"
                                  name="{{ card_id }}-option-{{ option_index }}"
                                  value="{{ value_name | escape }}"
                                  {% if option.selected_value == value_name %}checked{% endif %}
                                >
                                <span>{{ value_name | escape }}</span>
                              </label>
                            {%- endfor -%}
                          </div>
                        </fieldset>
                      {%- endfor -%}
                    {%- else -%}
                      <p class="mmb-card__weight" data-mmb-card-weight hidden></p>
                    {%- endif -%}

                    <div class="mmb-card__actions">
                      <button
                        type="button"
                        class="mmb-card__add"
                        data-mmb-action="toggle"
                        aria-label="Add {{ product.title | escape }} to your mix"
                        {% unless product.available %}
                          disabled
                        {% endunless %}
                      >
                        {{- icon_btn_plus -}}
                        {{- icon_btn_check -}}
                        <span data-mmb-add-label>
                          {%- if product.available -%}{{ s.add_button_text | escape }}{%- else -%}Sold out{%- endif -%}
                        </span>
                      </button>
                      <p class="mmb-card__msg" data-mmb-card-msg hidden></p>
                    </div>
                  </div>

                  <script type="application/json" data-mmb-product>
                    {
                      "id": {{ product.id | json }},
                      "handle": {{ product.handle | json }},
                      "title": {{ product.title | json }},
                      "regionalName": {{ regional_name | json }},
                      "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %},
                      "options": {{ product.options | json }},
                      "hasOnlyDefaultVariant": {{ product.has_only_default_variant | json }},
                      "initialVariantId": {{ initial_variant.id | json }},
                      "variants": [
                        {%- for variant in product.variants -%}
                          {%- liquid
                            assign meta_weight = nil
                            if vw_ns != blank
                              assign meta_weight = variant.metafields[vw_ns][vw_key]
                            endif
                            assign inventory_cap = nil
                            if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
                              assign inventory_cap = variant.inventory_quantity | at_least: 0
                            endif
                          -%}
                          {
                            "id": {{ variant.id | json }},
                            "title": {{ variant.title | json }},
                            "options": {{ variant.options | json }},
                            "price": {{ variant.price | json }},
                            "available": {{ variant.available | json }},
                            "shippingWeight": {{ variant.weight | default: 0 | json }},
                            "metaWeight": {%- if meta_weight.type == 'weight' -%}{"value": {{ meta_weight.value.value | json }}, "unit": {{ meta_weight.value.unit | json }}}{%- elsif meta_weight.value != blank -%}{"value": {{ meta_weight.value | json }}, "unit": "g"}{%- else -%}null{%- endif -%},
                            "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %},
                            "inventoryCap": {{ inventory_cap | json }},
                            "quantityRule": {
                              "min": {{ variant.quantity_rule.min | default: 1 | json }},
                              "max": {{ variant.quantity_rule.max | json }},
                              "increment": {{ variant.quantity_rule.increment | default: 1 | json }}
                            }
                          }{%- unless forloop.last -%},{%- endunless -%}
                        {%- endfor -%}
                      ]
                    }
                  </script>
                </li>
              {%- endfor -%}
            </ul>
          {%- endpaginate -%}
        {%- endif -%}

        <p class="mmb-grid-empty" data-mmb-grid-empty{% if mmb_total_items > 0 %} hidden{% endif %}>
          No spices are available right now. Please check back soon.
        </p>
        <p class="mmb-no-results" data-mmb-no-results hidden></p>

        {%- if s.pagination_type == 'load_more' -%}
          <div class="mmb-more" data-mmb-more hidden>
            <button type="button" class="mmb-btn mmb-btn--secondary" data-mmb-action="load-more">
              <span class="mmb-btn__spinner mmb-spinner" aria-hidden="true"></span>
              <span data-mmb-load-more-label>{{ s.load_more_text | escape }}</span>
            </button>
            <p class="mmb-more__count" data-mmb-more-count hidden></p>
            <p class="mmb-more__error" data-mmb-more-error hidden></p>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- 2. Summary panel ---------- {%- endcomment -%}
      <aside class="mmb__summary" data-mmb-summary aria-labelledby="{{ uid }}-summary-title">
        <div class="mmb-summary__head">
          <div class="mmb-step-head">
            {%- if s.show_step_numbers -%}<span class="mmb-step" aria-hidden="true">2</span>{%- endif -%}
            <{{ step_tag }} class="mmb-step-head__title" id="{{ uid }}-summary-title" tabindex="-1" data-mmb-summary-title>
              {{- s.summary_heading | escape -}}
            </{{ step_tag }}>
          </div>
          <p class="mmb-summary__count" data-mmb-count>0 spices</p>
        </div>

        <div class="mmb-meter">
          <div class="mmb-meter__row">
            <span class="mmb-meter__label">Total weight</span>
            <span class="mmb-meter__value" data-mmb-total-weight>0 g</span>
          </div>
          <div class="mmb-progress" data-mmb-progress role="progressbar" aria-label="Mix weight" aria-valuemin="0" hidden>
            <span class="mmb-progress__bar" data-mmb-progress-bar></span>
            <span class="mmb-progress__min" data-mmb-progress-min hidden></span>
          </div>
          <p class="mmb-meter__note" data-mmb-weight-note hidden></p>
        </div>

        <div class="mmb-lines-wrap">
          <ul class="mmb-lines" role="list" data-mmb-lines aria-label="Selected spices" hidden></ul>
          <div class="mmb-empty" data-mmb-empty>
            {{ icon_bowl }}
            <p>{{ s.empty_text | escape }}</p>
          </div>
        </div>

        <div class="mmb-totals">
          <div class="mmb-totals__row" data-mmb-subtotal-row hidden>
            <span>Items subtotal</span>
            <span class="mmb-totals__value" data-mmb-subtotal></span>
          </div>
          <div class="mmb-totals__row mmb-totals__row--savings" data-mmb-savings-row hidden>
            <span>Bundle savings</span>
            <span class="mmb-totals__value" data-mmb-savings></span>
          </div>
          <div class="mmb-totals__row mmb-totals__row--total">
            <span>{{ total_label }}</span>
            <span class="mmb-totals__value" data-mmb-total></span>
          </div>
          <p class="mmb-totals__note" data-mmb-pricing-note hidden></p>
        </div>

        <p class="mmb-hint" id="{{ uid }}-hint" data-mmb-hint></p>

        <div class="mmb-actions">
          <button
            type="button"
            class="mmb-btn mmb-btn--primary"
            data-mmb-action="add-to-cart"
            data-mmb-allow-disabled
            aria-describedby="{{ uid }}-hint"
            aria-disabled="true"
          >
            <span class="mmb-btn__spinner mmb-spinner" aria-hidden="true"></span>
            <span data-mmb-add-to-cart-label>{{ s.add_to_cart_text | escape }}</span>
          </button>

          <div class="mmb-message" data-mmb-message hidden></div>

          {%- if s.show_save or s.show_reset -%}
            <div class="mmb-actions__row">
              {%- if s.show_save -%}
                <button type="button" class="mmb-btn mmb-btn--secondary" data-mmb-action="save" data-mmb-allow-disabled aria-disabled="true">
                  <span class="mmb-btn__spinner mmb-spinner" aria-hidden="true"></span>
                  <span>{{ s.save_text | escape }}</span>
                </button>
              {%- endif -%}
              {%- if s.show_reset -%}
                <button type="button" class="mmb-btn mmb-btn--link" data-mmb-action="reset" aria-disabled="true">
                  {{- s.reset_text | escape -}}
                </button>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if s.show_reset -%}
            <div class="mmb-confirm" data-mmb-reset-confirm role="group" aria-labelledby="{{ uid }}-reset-text" hidden>
              <p id="{{ uid }}-reset-text" data-mmb-reset-confirm-text></p>
              <button type="button" class="mmb-btn mmb-btn--danger" data-mmb-action="reset-confirm">Yes, clear all</button>
              <button type="button" class="mmb-btn mmb-btn--link" data-mmb-action="reset-cancel">Cancel</button>
            </div>
          {%- endif -%}

          {%- if s.show_save -%}
            <div class="mmb-saved" data-mmb-saved hidden>
              <span class="mmb-saved__label" data-mmb-saved-label></span>
              <button type="button" class="mmb-btn mmb-btn--link" data-mmb-action="restore" aria-label="Load saved blend">Load</button>
              <button type="button" class="mmb-btn mmb-btn--link" data-mmb-action="forget" aria-label="Remove saved blend from this browser">
                Forget
              </button>
            </div>
            {%- if s.save_note != blank -%}
              <p class="mmb-save-note">{{ s.save_note | escape }}</p>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if features.size > 0 -%}
          <ul class="mmb-features" role="list">
            {%- for block in features -%}
              <li class="mmb-feature" {{ block.shopify_attributes }}>
                <span class="mmb-feature__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'mortar' -%}
                      <svg class="mmb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3 11h18a9 9 0 0 1-18 0Z"/><path d="m14 11 5-7"/></svg>
                    {%- when 'sparkle' -%}
                      <svg class="mmb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6.3 6.3l2.5 2.5M15.2 15.2l2.5 2.5M6.3 17.7l2.5-2.5M15.2 8.8l2.5-2.5"/></svg>
                    {%- when 'truck' -%}
                      <svg class="mmb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>
                    {%- when 'shield' -%}
                      <svg class="mmb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
                    {%- when 'heart' -%}
                      <svg class="mmb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/></svg>
                    {%- else -%}
                      <svg class="mmb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14Z"/><path d="m5 19 8-8"/></svg>
                  {%- endcase -%}
                </span>
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </aside>
    </div>
  </div>

  {%- if s.show_mobile_bar -%}
    <div class="mmb-bar" data-mmb-bar>
      <span class="mmb-bar__text" data-mmb-bar-text></span>
      <button type="button" class="mmb-bar__btn" data-mmb-action="view-mix">Review mix</button>
    </div>
  {%- endif -%}

  <div class="mmb-visually-hidden" data-mmb-live="polite" aria-live="polite" aria-atomic="true"></div>
  <div class="mmb-visually-hidden" data-mmb-live="assertive" aria-live="assertive" aria-atomic="true"></div>

  <template data-mmb-line-template>
    <li class="mmb-line">
      <div class="mmb-line__thumb" aria-hidden="true">
        <img data-mmb-line-img alt="" width="48" height="48" loading="lazy" hidden>
      </div>
      <div class="mmb-line__main">
        <p class="mmb-line__title" data-mmb-line-title></p>
        <p class="mmb-line__regional" data-mmb-line-regional hidden></p>
        <div class="mmb-line__controls">
          <label class="mmb-select-wrap" data-mmb-line-select-wrap>
            <span class="mmb-visually-hidden" data-mmb-line-select-label></span>
            <select class="mmb-select" data-mmb-variant-select></select>
          </label>
          <span class="mmb-line__static" data-mmb-line-static hidden></span>
          <div class="mmb-stepper" role="group" data-mmb-stepper>
            <button type="button" class="mmb-stepper__btn" data-mmb-action="decrease">{{ icon_minus }}</button>
            <span class="mmb-stepper__value" data-mmb-line-qty>1</span>
            <button type="button" class="mmb-stepper__btn" data-mmb-action="increase" data-mmb-allow-disabled>{{ icon_plus }}</button>
          </div>
        </div>
      </div>
      <div class="mmb-line__side">
        <button type="button" class="mmb-line__remove" data-mmb-action="remove">{{ icon_trash }}</button>
        <span class="mmb-line__weight" data-mmb-line-weight></span>
        <span class="mmb-line__meta" data-mmb-line-meta hidden></span>
        <span class="mmb-line__price" data-mmb-line-price></span>
      </div>
    </li>
  </template>

  <script type="application/json" data-mmb-config>
    {
      "sectionId": {{ section.id | json }},
      "storageKey": {{ 'masala-mix:' | append: shop.permanent_domain | append: ':' | append: section.id | json }},
      "customerId": {{ customer.id | json }},
      "designMode": {{ request.design_mode | json }},
      "locale": {{ request.locale.iso_code | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "currency": {{ cart.currency.iso_code | json }},
      "shopCurrency": {{ shop.currency | json }},
      "routes": {
        "root": {{ routes.root_url | json }},
        "cart": {{ routes.cart_url | json }},
        "cartJs": {{ routes.cart_url | append: '.js' | json }},
        "cartAdd": {{ routes.cart_add_url | append: '.js' | json }},
        "cartUpdate": {{ routes.cart_update_url | append: '.js' | json }}
      },
      "pagination": {
        "type": {{ s.pagination_type | json }},
        "currentPage": {{ mmb_current_page | default: 1 | json }},
        "totalPages": {{ mmb_total_pages | default: 1 | json }},
        "totalItems": {{ mmb_total_items | default: 0 | json }}
      },
      "catalog": {
        "weightOptionNames": {{ s.weight_option_names | default: '' | split: ',' | json }},
        "useShippingWeight": {{ s.use_shipping_weight | json }},
        "defaultWeight": {{ s.default_weight | default: '' | json }},
        "showRegionalName": {{ s.show_regional_name | json }},
        "hideSoldOut": {{ s.hide_sold_out | json }}
      },
      "limits": {
        "minWeight": {{ s.min_bundle_weight | default: 0 | json }},
        "maxWeight": {{ s.max_bundle_weight | default: 0 | json }},
        "minProducts": {{ s.min_products | default: 0 | json }},
        "maxProducts": {{ s.max_products | default: 0 | json }},
        "maxQtyPerItem": {{ s.max_quantity_per_item | json }}
      },
      "pricing": {
        "strategy": {{ s.pricing_strategy | json }},
        "fixedPrice": {{ fixed_cents | json }},
        "weightUnitGrams": {{ s.weight_unit_grams | default: 10 | json }},
        "weightPricePerUnit": {{ weight_rate_cents | json }},
        "weightTiers": [
          {%- assign tier_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'weight_tier' -%}
              {%- if tier_count > 0 -%},{%- endif -%}
              {%- assign tier_cents = block.settings.price_per_unit | default: '0' | remove: ',' | strip | times: 100 | round -%}
              {"minGrams": {{ block.settings.min_weight | default: 0 | json }}, "pricePerUnit": {{ tier_cents | json }}}
              {%- assign tier_count = tier_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        ],
        "discountCode": {{ s.discount_code | default: '' | strip | json }},
        "note": {{ s.pricing_note | default: '' | json }}
      },
      "cart": {
        "mode": {{ s.cart_mode | json }},
        "bundleProduct": {%- if bundle_variant -%}{"id": {{ bundle_product.id | json }}, "variant": {"id": {{ bundle_variant.id | json }}, "price": {{ bundle_variant.price | json }}, "available": {{ bundle_variant.available | json }}}}{%- else -%}null{%- endif -%},
        "addProperties": {{ s.add_bundle_properties | json }},
        "bundleName": {{ s.bundle_name | default: 'Custom Masala Mix' | json }},
        "afterAdd": {{ s.after_add | json }},
        "sections": {{ s.cart_sections | default: '' | json }},
        "countSelector": {{ s.cart_count_selector | default: '' | json }},
        "clearAfterAdd": {{ s.clear_after_add | json }}
      },
      "saving": {
        "endpoint": {{ s.save_endpoint | default: '' | strip | json }}
      },
      "reset": {
        "confirmThreshold": {{ s.reset_confirm_threshold | json }}
      },
      "strings": {
        "add": {{ s.add_button_text | default: 'Add' | json }},
        "added": {{ s.added_button_text | default: 'Added' | json }},
        "addToCart": {{ s.add_to_cart_text | default: 'Add to Cart' | json }},
        "loadMore": {{ s.load_more_text | default: 'Load More Spices' | json }},
        "propBundle": {{ s.line_property_name | default: 'Bundle' | json }},
        "propBlend": "Blend",
        "propTotalWeight": "Total weight",
        "adding": "Adding…",
        "loading": "Loading…",
        "addToMix": "Add {title} to your mix",
        "removeFromMix": "Remove {title} from your mix",
        "removeLine": "Remove {title}",
        "decrease": "Decrease quantity of {title}",
        "increase": "Increase quantity of {title}",
        "quantityFor": "Quantity of {title}",
        "weightFor": "Weight option for {title}",
        "soldOut": "Sold out",
        "unavailable": "Unavailable",
        "variantSoldOut": "{title} isn’t available in that option. Please choose another weight.",
        "unknownWeight": "{title} can’t be added yet because its weight isn’t set up.",
        "maxWeight": "That would take your mix over {max}. You have {remaining} left.",
        "maxProducts": "You can choose up to {max} spices.",
        "maxQuantity": "You can add up to {max} of {title}.",
        "minProducts": "Choose at least {min} spices ({remaining} more to go).",
        "minWeight": "Add {remaining} more to reach the {min} minimum.",
        "overWeight": "Your mix is over the {max} limit. Remove or reduce a spice.",
        "empty": "Add at least one spice to your mix.",
        "ready": "Your mix is ready.",
        "unavailableInMix": "{title} is no longer available. Remove it to continue.",
        "bundleMissing": "This bundle can’t be purchased right now. Please contact us.",
        "bundleSoldOut": "This bundle is sold out right now.",
        "lineAdded": "{title}, {weight}, added. Mix total {total}.",
        "lineRemoved": "{title} removed. Mix total {total}.",
        "lineUpdated": "{title} updated to {weight}. Mix total {total}.",
        "spiceOne": "{count} spice",
        "spiceOther": "{count} spices",
        "resultsOne": "{count} spice found",
        "resultsOther": "{count} spices found",
        "noResults": "No spices match “{query}”.",
        "searching": "Searching all spices…",
        "showing": "Showing {shown} of {total} spices",
        "loaded": "{count} more spices loaded.",
        "loadMoreError": "We couldn’t load more spices. Please try again.",
        "remaining": "{remaining} left of {max}",
        "toMinimum": "{remaining} more to reach {min}",
        "minimumReached": "Minimum weight reached",
        "weightOf": "{current} of {target}",
        "perUnit": "{price} per {unit} of blend",
        "addedToCart": "Your masala mix was added to the cart.",
        "viewCart": "View cart",
        "cartError": "We couldn’t add your mix to the cart. Please try again.",
        "network": "We couldn’t reach the store. Check your connection and try again.",
        "timeout": "The store took too long to respond. Please try again.",
        "malformed": "The store sent an unexpected response. Please refresh the page and try again.",
        "tooMany": "Too many requests. Please wait a moment and try again.",
        "discountFailed": "Your spices were added, but the bundle discount couldn’t be applied automatically.",
        "saved": "Blend saved in this browser. It won’t appear on other devices.",
        "savedAccount": "Blend saved to your account.",
        "saveFailed": "We couldn’t save your blend. Your browser may be blocking storage.",
        "saveEmpty": "Add spices before saving your blend.",
        "savedBlend": "Saved blend: {count} · {date}",
        "restored": "Your saved blend has been loaded.",
        "restoredPartial": "Saved blend loaded. {count} item(s) were skipped because they’re unavailable or exceed your mix limits.",
        "forgotten": "Saved blend removed from this browser.",
        "resetConfirm": "Remove all {count} spices from your mix?",
        "resetDone": "Your mix has been cleared.",
        "g": "g",
        "kg": "kg"
      }
    }
  </script>
</masala-mix-builder>

{% schema %}
{
  "name": "Masala Mix Builder",
  "tag": "section",
  "class": "mmb-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 16,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section heading",
      "default": "Build Your Own Masala Mix"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section description",
      "default": "Handpick your spices, choose the weight of each, and we’ll pack your custom masala fresh."
    },
    {
      "type": "checkbox",
      "id": "show_step_numbers",
      "label": "Show step numbers",
      "default": true
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Step 1 heading",
      "default": "Choose Your Spices"
    },
    {
      "type": "textarea",
      "id": "products_description",
      "label": "Step 1 description",
      "default": "Select the spices you want to include in your custom masala."
    },
    {
      "type": "text",
      "id": "summary_heading",
      "label": "Step 2 heading",
      "default": "Your Masala Mix"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty mix message",
      "default": "Your mix is empty. Add spices to start blending."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Spice collection"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products to load initially",
      "info": "Also the number of products fetched by each “Load more”.",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 12
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "More products",
      "options": [
        { "value": "load_more", "label": "Show “Load more” button" },
        { "value": "all", "label": "Load all products automatically" },
        { "value": "none", "label": "Only show the first page" }
      ],
      "default": "load_more"
    },
    {
      "type": "text",
      "id": "load_more_text",
      "label": "Load more button text",
      "default": "Load More Spices"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "info": "Searching loads any remaining pages so the whole collection is searched.",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search spices…"
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "Hide sold-out products",
      "default": false
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Products per row (mobile)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "natural", "label": "Original image" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Fill (crop)" },
        { "value": "contain", "label": "Fit (no crop)" }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_card_price",
      "label": "Show price on cards",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_weight_selectors",
      "label": "Show weight selectors on cards",
      "info": "When hidden, customers can still change weight in the mix summary.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_regional_name",
      "label": "Show regional names",
      "default": true
    },
    {
      "type": "text",
      "id": "regional_name_metafield",
      "label": "Regional name product metafield",
      "info": "namespace.key of a single-line text product metafield, e.g. custom.regional_name",
      "default": "custom.regional_name"
    },
    {
      "type": "text",
      "id": "add_button_text",
      "label": "Add button text",
      "default": "Add"
    },
    {
      "type": "text",
      "id": "added_button_text",
      "label": "Added button text",
      "default": "Added"
    },
    {
      "type": "header",
      "content": "Weights & limits"
    },
    {
      "type": "paragraph",
      "content": "Variant weight is read from the metafield below, then from the option value or variant title (e.g. “10 g”, “0.5 kg”), then from the shipping weight if enabled."
    },
    {
      "type": "text",
      "id": "variant_weight_metafield",
      "label": "Variant weight metafield",
      "info": "namespace.key of a variant metafield (Weight type, or a number in grams).",
      "default": "custom.bundle_weight_grams"
    },
    {
      "type": "text",
      "id": "weight_option_names",
      "label": "Weight option names",
      "info": "Comma-separated option names that hold the weight.",
      "default": "Weight, Size, Pack size"
    },
    {
      "type": "checkbox",
      "id": "use_shipping_weight",
      "label": "Fall back to shipping weight",
      "info": "Only enable if shipping weight equals spice weight (no packaging).",
      "default": false
    },
    {
      "type": "text",
      "id": "default_weight",
      "label": "Preselected weight",
      "info": "e.g. 10 g. Cards preselect this weight when available."
    },
    {
      "type": "range",
      "id": "max_quantity_per_item",
      "label": "Max packs per spice",
      "info": "Set to 1 to hide quantity controls.",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 5
    },
    {
      "type": "number",
      "id": "min_bundle_weight",
      "label": "Minimum mix weight (g)",
      "info": "0 = no minimum",
      "default": 0
    },
    {
      "type": "number",
      "id": "max_bundle_weight",
      "label": "Maximum mix weight (g)",
      "info": "0 = no maximum",
      "default": 0
    },
    {
      "type": "number",
      "id": "min_products",
      "label": "Minimum number of spices",
      "default": 1
    },
    {
      "type": "number",
      "id": "max_products",
      "label": "Maximum number of spices",
      "info": "0 = no maximum",
      "default": 0
    },
    {
      "type": "header",
      "content": "Cart & pricing"
    },
    {
      "type": "select",
      "id": "cart_mode",
      "label": "Add to cart as",
      "options": [
        { "value": "individual", "label": "Individual spice products (recommended)" },
        { "value": "bundle_product", "label": "One bundle product" }
      ],
      "default": "individual",
      "info": "Individual lines keep each spice’s SKU and inventory. A bundle product does NOT deduct component inventory without a bundle app."
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Bundle product",
      "info": "Only for “One bundle product”. Its first available variant is added; the blend is saved as line item properties."
    },
    {
      "type": "select",
      "id": "pricing_strategy",
      "label": "Pricing strategy",
      "options": [
        { "value": "sum", "label": "Sum of individual products" },
        { "value": "fixed", "label": "Fixed bundle price" },
        { "value": "weight", "label": "Weight-based price" }
      ],
      "default": "sum",
      "info": "Bundle product mode: fixed = bundle variant price; weight-based = bundle variant price × weight units. Individual mode: fixed/weight-based need a matching discount."
    },
    {
      "type": "text",
      "id": "fixed_bundle_price",
      "label": "Fixed bundle price",
      "info": "Individual mode only. Store currency, numbers only, e.g. 499.00",
      "default": "499.00"
    },
    {
      "type": "number",
      "id": "weight_unit_grams",
      "label": "Weight pricing unit (g)",
      "info": "Weight-based pricing charges per started unit, e.g. 10 g.",
      "default": 10
    },
    {
      "type": "text",
      "id": "weight_price_per_unit",
      "label": "Price per weight unit",
      "info": "Individual mode only. Store currency, e.g. 20.00. Add “Weight price tier” blocks for volume rates.",
      "default": "20.00"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Bundle discount code",
      "info": "Optional. Individual mode with fixed/weight pricing: this code is applied to the cart after adding."
    },
    {
      "type": "text",
      "id": "pricing_note",
      "label": "Bundle pricing note",
      "default": "Bundle pricing is applied as a discount in your cart."
    },
    {
      "type": "checkbox",
      "id": "add_bundle_properties",
      "label": "Tag cart lines with the bundle",
      "info": "Individual mode: adds a visible bundle property and a hidden _bundle_id to each line.",
      "default": true
    },
    {
      "type": "text",
      "id": "line_property_name",
      "label": "Cart line property name",
      "default": "Bundle"
    },
    {
      "type": "text",
      "id": "bundle_name",
      "label": "Bundle name in cart",
      "default": "Custom Masala Mix"
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Add to cart button text",
      "default": "Add to Cart"
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding to cart",
      "options": [
        { "value": "drawer", "label": "Open cart drawer if available" },
        { "value": "stay", "label": "Stay and show a message" },
        { "value": "redirect", "label": "Go to cart page" }
      ],
      "default": "drawer"
    },
    {
      "type": "checkbox",
      "id": "clear_after_add",
      "label": "Clear the mix after adding to cart",
      "default": false
    },
    {
      "type": "text",
      "id": "cart_sections",
      "label": "Cart sections to refresh",
      "info": "Advanced. Comma-separated section IDs (max 5). Dawn: cart-drawer,cart-icon-bubble",
      "default": "cart-drawer,cart-icon-bubble"
    },
    {
      "type": "text",
      "id": "cart_count_selector",
      "label": "Cart count selector",
      "info": "Advanced. CSS selector of elements that show the cart item count.",
      "default": "[data-cart-count]"
    },
    {
      "type": "header",
      "content": "Save & reset"
    },
    {
      "type": "checkbox",
      "id": "show_save",
      "label": "Show “Save My Blend”",
      "default": true
    },
    {
      "type": "text",
      "id": "save_text",
      "label": "Save button text",
      "default": "Save My Blend"
    },
    {
      "type": "text",
      "id": "save_note",
      "label": "Save note",
      "default": "Saved blends are stored in this browser only."
    },
    {
      "type": "text",
      "id": "save_endpoint",
      "label": "Account save endpoint (optional)",
      "info": "App proxy URL, e.g. /apps/masala-blends. Logged-in customers’ blends are sent here; otherwise blends stay in the browser."
    },
    {
