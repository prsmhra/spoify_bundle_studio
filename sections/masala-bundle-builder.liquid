{%- comment -%}
  Section: Build Your Own Masala Mix
  ------------------------------------------------------------------
  Native Shopify Online Store 2.0 section. Lets a customer browse real
  products from a merchant-selected collection, pick Shopify variants
  (used for weight/quantity options when available) and build a custom
  spice bundle. "Add to Cart" adds every selected spice as its own real
  cart line item via /cart/add.js (Option A bundle architecture - every
  spice keeps its own SKU/inventory - see installation notes for detail).

  No fake product/variant data is used: every card is rendered from real
  Shopify product + variant objects, and "Load More" paginates the real
  collection using Shopify's Section Rendering API (?section_id=&page=).

  Assumptions (full detail in installation notes delivered alongside this
  file):
  - Weight options are read from a configurable Shopify variant OPTION
    (default name "Weight") with values such as "5 g" / "10 g" / "1 kg".
    Products without that option simply show a quantity-only Add control.
  - The optional "regional / local name" comes from a product metafield
    whose namespace/key are configurable below. The merchant must create
    that metafield definition in Shopify admin - this section only reads it.
  - "Fixed" and "Weight-based" pricing strategies are shown as clearly
    labelled ESTIMATES in the summary panel. Because each spice is added
    to the cart as its own real variant line item, Shopify always charges
    the true sum of the selected variant prices at checkout - this section
    never overrides a variant's real price.
  - "Save My Blend" is a device-local (localStorage) convenience only. It
    is not presented as permanent or cross-device customer storage.
{%- endcomment -%}

{{ 'masala-bundle-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'masala-bundle-builder.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign has_collection = false
  if s.collection != blank and s.collection.products.size > 0
    assign has_collection = true
  endif

  assign initial_count = s.initial_product_count | default: 9
  assign total_product_pages = 1
  if has_collection and initial_count > 0
    assign total_product_pages = s.collection.products_count | plus: initial_count | minus: 1 | divided_by: initial_count
  endif

  assign fixed_price_cents = s.fixed_bundle_price | times: 100 | round
  assign weight_price_per_unit_cents = s.weight_price_per_unit | times: 100 | round

  assign bg_color = s.background_color
  assign card_bg = s.card_background_color
  assign border_color = s.border_color
  assign btn_color = s.button_color
  assign btn_text_color = s.button_text_color
  assign heading_color = s.heading_color
  assign body_color = s.body_text_color
  assign accent_color = s.accent_text_color

  if s.color_scheme != blank
    if bg_color == blank
      assign bg_color = s.color_scheme.settings.background
    endif
    if body_color == blank
      assign body_color = s.color_scheme.settings.text
    endif
    if btn_color == blank
      assign btn_color = s.color_scheme.settings.button
    endif
    if btn_text_color == blank
      assign btn_text_color = s.color_scheme.settings.button_label
    endif
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .masala-builder {
    --mbb-bg: {{ bg_color | default: '#FBF4E8' }};
    --mbb-card-bg: {{ card_bg | default: '#FFFFFF' }};
    --mbb-border: {{ border_color | default: '#E3D7BE' }};
    --mbb-btn: {{ btn_color | default: '#1E3B2B' }};
    --mbb-btn-text: {{ btn_text_color | default: '#FFFFFF' }};
    --mbb-heading: {{ heading_color | default: '#2B2018' }};
    --mbb-body: {{ body_color | default: '#5B4F42' }};
    --mbb-accent: {{ accent_color | default: '#8A5A2B' }};
    --mbb-pad-top-desktop: {{ s.padding_top_desktop | default: 60 }}px;
    --mbb-pad-bottom-desktop: {{ s.padding_bottom_desktop | default: 60 }}px;
    --mbb-pad-top-mobile: {{ s.padding_top_mobile | default: 32 }}px;
    --mbb-pad-bottom-mobile: {{ s.padding_bottom_mobile | default: 32 }}px;
    --mbb-row-desktop: {{ s.products_per_row_desktop | default: 3 }};
    --mbb-row-mobile: {{ s.products_per_row_mobile | default: 1 }};
  }
{%- endstyle -%}

<masala-bundle-builder
  class="masala-builder"
  data-section-id="{{ section.id }}"
  data-sticky-summary="{{ s.sticky_summary }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-locale="{{ request.locale.iso_code }}"
  data-pricing-strategy="{{ s.pricing_strategy }}"
  data-fixed-price-cents="{{ fixed_price_cents }}"
  data-weight-price-per-unit-cents="{{ weight_price_per_unit_cents }}"
  data-weight-price-unit-grams="{{ s.weight_price_unit_grams | default: 100 }}"
  data-min-weight="{{ s.min_bundle_weight | default: 0 }}"
  data-max-weight="{{ s.max_bundle_weight | default: 0 }}"
  data-min-count="{{ s.min_product_count | default: 0 }}"
  data-max-count="{{ s.max_product_count | default: 0 }}"
  data-reset-confirm-threshold="{{ s.reset_confirm_threshold | default: 0 }}"
  data-weight-option-name="{{ s.weight_option_name | default: 'Weight' }}"
  data-products-per-page="{{ s.initial_product_count | default: 9 }}"
  data-collection-handle="{{ s.collection.handle }}"
  data-section-url="{{ request.path }}"
  data-show-load-more="{{ s.show_load_more }}"
  data-total-pages="{{ total_product_pages | default: 1 }}"
>
  <div class="mbb-container">

    {%- if s.heading != blank or s.description != blank -%}
      <header class="mbb-header">
        {%- if s.heading != blank -%}
          <h2 class="mbb-heading">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.description != blank -%}
          <div class="mbb-description">{{ s.description }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="mbb-badges" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_badge' -%}
            <li class="mbb-badge" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="mbb-badge__icon">{{ block.settings.icon | image_url: width: 48 | image_tag: loading: 'lazy', width: 24, height: 24 }}</span>
              {%- endif -%}
              <span class="mbb-badge__text">{{ block.settings.text }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="mbb-status mbb-visually-hidden" data-mbb-status role="status" aria-live="polite"></div>
    <div class="mbb-status mbb-status--error mbb-visually-hidden" data-mbb-error-status role="alert" aria-live="assertive"></div>

    <div class="mbb-layout">
      <section class="mbb-selector" aria-labelledby="mbb-step1-heading-{{ section.id }}">
        <div class="mbb-selector__head">
          <h3 class="mbb-selector__heading" id="mbb-step1-heading-{{ section.id }}">{{ s.step_one_heading | default: '1. Choose Your Spices' }}</h3>
          {%- if s.step_one_description != blank -%}
            <p class="mbb-selector__description">{{ s.step_one_description }}</p>
          {%- endif -%}
        </div>

        {%- if s.show_search and has_collection -%}
          <div class="mbb-search" role="search">
            <svg class="mbb-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <label class="mbb-visually-hidden" for="mbb-search-input-{{ section.id }}">Search spices</label>
            <input
              type="search"
              id="mbb-search-input-{{ section.id }}"
              class="mbb-search__input"
              data-mbb-search-input
              placeholder="Search spices by name…"
              autocomplete="off"
            >
            <button type="button" class="mbb-search__clear mbb-visually-hidden" data-mbb-search-clear aria-label="Clear search">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
          </div>
        {%- endif -%}

        <div class="mbb-grid" data-mbb-grid role="list" aria-label="Spice products">
          {%- if has_collection -%}
            {%- paginate s.collection.products by initial_count -%}
              {%- for product in s.collection.products -%}
                {%- render 'masala-product-card', product: product, section: section, s: s -%}
              {%- endfor -%}
            {%- endpaginate -%}
          {%- else -%}
            <div class="mbb-grid__empty">
              Select a collection in the section settings to display spices here.
            </div>
          {%- endif -%}
        </div>

        {%- if s.show_load_more and has_collection and total_product_pages > 1 -%}
          <div class="mbb-load-more-wrap">
            <button type="button" class="mbb-btn mbb-btn--outline" data-mbb-load-more>
              <span data-mbb-load-more-label>{{ s.load_more_label | default: 'Load More Spices' }}</span>
              <span class="mbb-spinner mbb-visually-hidden" data-mbb-load-more-spinner aria-hidden="true"></span>
            </button>
          </div>
        {%- endif -%}
      </section>

      <aside class="mbb-summary{% if s.sticky_summary %} mbb-summary--sticky{% endif %}" aria-labelledby="mbb-step2-heading-{{ section.id }}">
        <div class="mbb-summary__card">
          <div class="mbb-summary__head">
            <h3 class="mbb-summary__heading" id="mbb-step2-heading-{{ section.id }}">{{ s.step_two_heading | default: '2. Your Masala Mix' }}</h3>
            {%- if s.step_two_description != blank -%}
              <p class="mbb-summary__description">{{ s.step_two_description }}</p>
            {%- endif -%}
          </div>

          <div class="mbb-summary__weight" data-mbb-weight-summary>
            <div class="mbb-summary__weight-row">
              <span>Total weight</span>
              <strong data-mbb-total-weight>0 g</strong>
            </div>
            {%- if s.max_bundle_weight and s.max_bundle_weight > 0 -%}
              <div class="mbb-summary__weight-row mbb-summary__weight-row--muted">
                <span>Remaining</span>
                <strong data-mbb-remaining-weight>{{ s.max_bundle_weight }} g</strong>
              </div>
              <div class="mbb-progress" aria-hidden="true">
                <div class="mbb-progress__bar" data-mbb-progress-bar style="width:0%"></div>
              </div>
            {%- endif -%}
          </div>

          <ul class="mbb-summary__list" data-mbb-summary-list role="list" aria-label="Selected spices">
            <li class="mbb-summary__empty" data-mbb-summary-empty>
              No spices selected yet. Choose spices on the left to start building your mix.
            </li>
          </ul>

          <div class="mbb-summary__totals">
            <div class="mbb-summary__totals-row mbb-summary__totals-row--main">
              <span>Total price</span>
              <strong data-mbb-total-price>{{ 0 | money }}</strong>
            </div>
            <p class="mbb-summary__price-note mbb-visually-hidden" data-mbb-price-note></p>
          </div>

          <div class="mbb-summary__actions">
            <button type="button" class="mbb-btn mbb-btn--primary mbb-btn--block" data-mbb-add-to-cart disabled aria-disabled="true">
              <span data-mbb-add-to-cart-label>{{ s.add_to_cart_text | default: 'Add to Cart' }}</span>
              <span class="mbb-spinner mbb-visually-hidden" data-mbb-add-to-cart-spinner aria-hidden="true"></span>
            </button>

            <div class="mbb-summary__secondary-actions">
              {%- if s.show_save_blend -%}
                <button type="button" class="mbb-btn mbb-btn--text" data-mbb-save-blend>
                  {{ s.save_blend_text | default: 'Save My Blend' }}
                </button>
              {%- endif -%}
              {%- if s.show_reset -%}
                <button type="button" class="mbb-btn mbb-btn--text mbb-btn--muted" data-mbb-reset-all>
                  {{ s.reset_text | default: 'Reset All' }}
                </button>
              {%- endif -%}
            </div>

            {%- if s.show_save_blend -%}
              <p class="mbb-summary__saved-note mbb-visually-hidden" data-mbb-saved-note role="status" aria-live="polite"></p>
            {%- endif -%}
          </div>
        </div>
      </aside>
    </div>
  </div>

  {%- comment -%} Template used by JS to render each summary line item (cloned, never rendered directly). {%- endcomment -%}
  <template data-mbb-line-item-template>
    <li class="mbb-line-item" data-mbb-line-item>
      <img class="mbb-line-item__image" data-mbb-line-image src="" alt="" width="48" height="48" loading="lazy">
      <div class="mbb-line-item__info">
        <p class="mbb-line-item__title" data-mbb-line-title></p>
        <p class="mbb-line-item__meta" data-mbb-line-meta></p>
      </div>
      <div class="mbb-line-item__controls">
        <div class="mbb-line-item__stepper" data-mbb-line-stepper>
          <button type="button" class="mbb-qty-btn mbb-qty-btn--sm" data-mbb-line-decrease aria-label="Decrease">−</button>
          <span class="mbb-qty-value" data-mbb-line-qty-value aria-live="polite"></span>
          <button type="button" class="mbb-qty-btn mbb-qty-btn--sm" data-mbb-line-increase aria-label="Increase">+</button>
        </div>
        <button type="button" class="mbb-line-item__remove" data-mbb-line-remove aria-label="Remove">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
      <p class="mbb-line-item__price" data-mbb-line-price></p>
    </li>
  </template>
</masala-bundle-builder>

{% schema %}
{
  "name": "Build Your Own Masala Mix",
  "tag": "section",
  "class": "section-masala-bundle-builder",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Own Masala Mix"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Hand-pick your favourite spices and build a custom masala blend, just the way you like it.</p>"
    },
    {
      "type": "text",
      "id": "step_one_heading",
      "label": "Step 1 heading",
      "default": "1. Choose Your Spices"
    },
    {
      "type": "text",
      "id": "step_one_description",
      "label": "Step 1 description",
      "default": "Select the spices you want to include in your custom masala."
    },
    {
      "type": "text",
      "id": "step_two_heading",
      "label": "Step 2 heading",
      "default": "2. Your Masala Mix"
    },
    {
      "type": "text",
      "id": "step_two_description",
      "label": "Step 2 description",
      "default": "Review and fine-tune your blend before adding it to your cart."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Spice collection",
      "info": "Products are loaded dynamically from this collection."
    },
    {
      "type": "range",
      "id": "initial_product_count",
      "label": "Products to load initially",
      "min": 3,
      "max": 48,
      "step": 3,
      "default": 9
    },
    {
      "type": "range",
      "id": "products_per_row_desktop",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "products_per_row_mobile",
      "label": "Products per row (mobile)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show product search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_weight_selectors",
      "label": "Show weight selectors",
      "default": true
    },
    {
      "type": "text",
      "id": "weight_option_name",
      "label": "Weight option name",
      "default": "Weight",
      "info": "The name of the Shopify product option that holds weight values, e.g. 5 g / 10 g / 1 kg."
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Product image aspect ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "3/4", "label": "Portrait (3:4)" }
      ],
      "default": "1/1"
    },
    {
      "type": "checkbox",
      "id": "show_regional_name",
      "label": "Show regional / local name",
      "default": true
    },
    {
      "type": "text",
      "id": "regional_name_namespace",
      "label": "Regional name metafield namespace",
      "default": "custom",
      "info": "Requires a product metafield definition created in Shopify admin."
    },
    {
      "type": "text",
      "id": "regional_name_key",
      "label": "Regional name metafield key",
      "default": "regional_name"
    },
    {
      "type": "checkbox",
      "id": "show_load_more",
      "label": "Show \"Load More Spices\" button",
      "default": true
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Load more button text",
      "default": "Load More Spices"
    },
    {
      "type": "header",
      "content": "Bundle rules"
    },
    {
      "type": "range",
      "id": "min_bundle_weight",
      "label": "Minimum bundle weight (g)",
      "min": 0,
      "max": 1000,
      "step": 10,
      "default": 0,
      "info": "Set to 0 for no minimum."
    },
    {
      "type": "range",
      "id": "max_bundle_weight",
      "label": "Maximum bundle weight (g)",
      "min": 0,
      "max": 2000,
      "step": 20,
      "default": 0,
      "info": "Set to 0 for no maximum."
    },
    {
      "type": "range",
      "id": "min_product_count",
      "label": "Minimum number of products",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "max_product_count",
      "label": "Maximum number of products",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "info": "Set to 0 for no maximum."
    },
    {
      "type": "header",
      "content": "Pricing"
    },
    {
      "type": "select",
      "id": "pricing_strategy",
      "label": "Pricing strategy",
      "options": [
        { "value": "sum", "label": "Sum of individual products" },
        { "value": "fixed", "label": "Fixed bundle price (estimate)" },
        { "value": "weight_based", "label": "Weight-based pricing (estimate)" }
      ],
      "default": "sum",
      "info": "The cart always charges the real sum of selected variant prices. Fixed and weight-based strategies are shown as labelled price estimates in the summary panel."
    },
    {
      "type": "number",
      "id": "fixed_bundle_price",
      "label": "Fixed bundle price",
      "default": 0,
      "info": "Used only when pricing strategy is \"Fixed bundle price\"."
    },
    {
      "type": "number",
      "id": "weight_price_per_unit",
      "label": "Price per weight unit",
      "default": 0,
      "info": "Used only when pricing strategy is \"Weight-based pricing\"."
    },
    {
      "type": "range",
      "id": "weight_price_unit_grams",
      "label": "Weight unit size (g)",
      "min": 10,
      "max": 1000,
      "step": 10,
      "default": 100,
      "info": "E.g. 100 g means the price above applies per 100 g of selected weight."
    },
    {
      "type": "header",
      "content": "Actions"
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Add to cart button text",
      "default": "Add to Cart"
    },
    {
      "type": "checkbox",
      "id": "show_save_blend",
      "label": "Show \"Save My Blend\" button",
      "default": true
    },
    {
      "type": "text",
      "id": "save_blend_text",
      "label": "Save blend button text",
      "default": "Save My Blend"
    },
    {
      "type": "checkbox",
      "id": "show_reset",
      "label": "Show \"Reset All\" button",
      "default": true
    },
    {
      "type": "text",
      "id": "reset_text",
      "label": "Reset button text",
      "default": "Reset All"
    },
    {
      "type": "range",
      "id": "reset_confirm_threshold",
      "label": "Confirm reset above this many selected products",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 3,
      "info": "Set to 0 to never ask for confirmation."
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Used as a base. Requires your theme to define color schemes under theme settings. Leave colors below blank to inherit from this scheme."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "info": "Overrides the color scheme background."
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Accent text color",
      "info": "Used for regional names and small highlights."
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "sticky_summary",
      "label": "Make bundle summary sticky on desktop",
      "default": true
    }
  ],
  "blocks": [
    {
